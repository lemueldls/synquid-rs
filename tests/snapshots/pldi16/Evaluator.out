transform :: x:AST -> {PAST|result2 _v == result x}
transform = \x . 
  match x with
    One -> IntNode one
    Zero -> IntNode zero
    Two -> IntNode two
    PlusNode x6 x7 -> OpNode zero
                        (transform x6) (transform x7)
    MinusNode x15 x16 -> OpNode one
                           (transform x15) (transform x16)
    ProductNode x24 x25 -> OpNode
                             two (transform x24) (transform
                                                    x25)
