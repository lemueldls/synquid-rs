insert :: x:a -> xs:IList a -> {IList a|ielems _v == ielems xs + [x]}
insert = \x . \xs . 
    match xs with
      INil -> ICons x INil
      ICons x5 x6 -> 
        if x5 < x
          then ICons x5 (insert x x6)
          else 
            if x < x5
              then ICons x (ICons x5 x6)
              else xs
