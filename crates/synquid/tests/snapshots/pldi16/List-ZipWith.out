zipWith :: f:(arg1:a -> arg0:b -> c) -> xs:List a -> ys:{List b|len _v == len xs} -> {List c|len _v == len xs}
zipWith = \f . \xs . \ys . 
      match xs with
        Nil -> Nil
        Cons x3 x4 -> 
          match ys with
            Nil -> error
            Cons x7 x8 -> Cons (f x3 x7)
                            (zipWith f x4 x8)
