intersect :: xs:SList a -> ys:SList a -> {SList a|elems _v == elems xs * elems ys}
intersect = \xs . \ys . 
    match xs with
      Nil -> xs
      Cons x4 x5 -> 
        match ys with
          Nil -> ys
          Cons x8 x9 -> 
            if x4 < x8
              then intersect x5 ys
              else 
                if x8 < x4
                  then intersect xs x9
                  else Cons x4 (intersect x5 x9)
