{
  "name": "Synquid",
  "scopeName": "source.synquid",
  "patterns": [
    {
      "comment": "line comment",
      "name": "comment.line.double-dash.synquid",
      "match": "--.*$"
    },
    {
      "comment": "block comment (non-nested)",
      "name": "comment.block.synquid",
      "begin": "\\{-",
      "end": "-\\}"
    },
    {
      "comment": "function signature name (line-anchored, lookahead keeps :: unscoped)",
      "name": "entity.name.function.synquid",
      "match": "^\\s*([a-z][A-Za-z0-9_']*)(?=\\s*::)"
    },
    {
      "comment": "synthesis goal name",
      "name": "entity.name.function.synquid",
      "match": "^\\s*([a-z][A-Za-z0-9_']*)(?=\\s*=\\s*\\?\\?)"
    },
    {
      "comment": "measure/predicate/inline declaration name",
      "name": "keyword.declaration.synquid",
      "match": "^\\s*(?:termination\\s+)?(?:measure|predicate|inline)\\s+([a-z][A-Za-z0-9_']*)",
      "captures": {
        "1": {
          "name": "entity.name.function.synquid"
        }
      }
    },
    {
      "comment": "declaration keywords",
      "name": "keyword.declaration.synquid",
      "match": "\\b(?:data|inline|measure|mutual|predicate|qualifier|termination|type)\\b"
    },
    {
      "comment": "control keywords",
      "name": "keyword.control.synquid",
      "match": "\\b(?:else|error|if|in|let|match|then|where|with)\\b"
    },
    {
      "comment": "boolean literals",
      "name": "constant.language.boolean.synquid",
      "match": "\\b(?:True|False)\\b"
    },
    {
      "comment": "builtin sorts",
      "name": "storage.type.synquid",
      "match": "\\b(?:Bool|Int|Set)\\b"
    },
    {
      "comment": "synthesis hole",
      "name": "constant.placeholder.synquid",
      "match": "\\?\\?"
    },
    {
      "comment": "integer literals",
      "name": "constant.numeric.integer.synquid",
      "match": "\\b\\d+\\b"
    },
    {
      "comment": "type signature operator",
      "name": "keyword.operator.type.synquid",
      "match": "::"
    },
    {
      "comment": "multi-character operators (longest first)",
      "name": "keyword.operator.synquid",
      "match": "==>|<==>|&&|\\|\\||==|!=|<=|>=|->"
    },
    {
      "comment": "single-character operators",
      "name": "keyword.operator.synquid",
      "match": "!|\\*|\\+|-|<|>|:|=|\\||\\\\"
    },
    {
      "comment": "implicit value variable",
      "name": "variable.language.synquid",
      "match": "\\b_v(?![A-Za-z0-9_'])"
    },
    {
      "comment": "positional predicate variables",
      "name": "variable.language.synquid",
      "match": "\\b_[0-9]+(?![A-Za-z0-9_'])"
    },
    {
      "comment": "wildcard binder",
      "name": "variable.language.synquid",
      "match": "\\b_(?![A-Za-z0-9_'])"
    },
    {
      "comment": "data constructors and type names",
      "name": "entity.name.type.synquid",
      "match": "\\b[A-Z][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
    },
    {
      "comment": "identifiers starting with an underscore",
      "name": "variable.other.synquid",
      "match": "\\b_[a-z][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
    },
    {
      "comment": "variables, functions, measures, predicates",
      "name": "variable.other.synquid",
      "match": "\\b[a-z][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
    },
    {
      "comment": "brackets",
      "name": "punctuation.section.synquid",
      "match": "\\(|\\)|\\[|\\]|\\{|\\}"
    },
    {
      "comment": "separators",
      "name": "punctuation.separator.synquid",
      "match": ","
    },
    {
      "comment": "dot",
      "name": "punctuation.accessor.synquid",
      "match": "\\."
    }
  ]
}
